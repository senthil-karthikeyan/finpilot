{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NestJS requires CommonJS modules and reflect-metadata support.
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "lib": ["ES2021"],
    "outDir": "./dist",
    "rootDir": "./src",
    // Decorators — required by NestJS (@Module, @Injectable, @Controller, etc.)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Faster incremental builds
    "incremental": true,
    // Path aliases: resolve @finpilot/shared directly to source in dev
    // so the shared package does not need to be built before the API starts.
    "paths": {
      "@finpilot/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}

