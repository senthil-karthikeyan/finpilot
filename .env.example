# ── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://finpilot:finpilot@localhost:5432/finpilot

# ── API (apps/api) ──────────────────────────────────────────────────────────
# A long random string; change this in every environment
JWT_SECRET=change-me-to-a-long-random-string-in-production

# Cookie max-age in seconds (8 hours)
JWT_COOKIE_MAX_AGE_SECONDS=28800

# Port the NestJS API listens on
PORT=3001

NODE_ENV=development

# Allow the Next.js origin to send credentialed requests
CORS_ORIGIN=http://localhost:3000

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# Consumed by Next.js server-side only (no NEXT_PUBLIC_ prefix = never exposed to browser)
API_URL=http://localhost:3001

# ── Docker Compose overrides (optional) ─────────────────────────────────────
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot
POSTGRES_DB=finpilot

