{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS output so both NestJS (CJS) and Next.js can consume it without
    // extra bundler configuration.
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}

