flowchart TD
  ClientReq(["Incoming HTTP Request<br/>(e.g., GET /api/v1/customers/C0001/portfolio)"]) --> ThrottlerGate{"Rate Limit Check<br/>(ThrottlerGuard)"}

  ThrottlerGate -- "Exceeded limit" --> Resp429["429 Too Many Requests<br/>(Rate limit exceeded)"]
  ThrottlerGate -- "Within limit" --> PublicCheck{"@Public() Decorator<br/>Present?"}

  PublicCheck -- "Yes (/health, /auth/login)" --> ValidationGate
  PublicCheck -- "No (Protected route)" --> JwtGate{"JWT Verification<br/>(JwtAuthGuard)"}

  JwtGate -- "Missing / Invalid / Expired Bearer" --> Resp401["401 Unauthorized<br/>(Invalid or missing token)"]
  JwtGate -- "Valid Bearer Token" --> AttachUser["Attach User Payload to Request<br/>(req.user: id, email, role)"]

  AttachUser --> RolesGate{"Role Authorization<br/>(RolesGuard @Roles)"}
  RolesGate -- "Role mismatch (e.g. VIEWER accessing /admin/*)" --> Resp403["403 Forbidden<br/>(Insufficient permissions)"]
  RolesGate -- "Authorized (e.g. ADMIN or VIEWER permitted)" --> ValidationGate{"Request Validation<br/>(ValidationPipe)"}

  ValidationGate -- "Invalid payload / query params" --> Resp400["400 Bad Request / 422 Unprocessable<br/>(Field validation errors)"]
  ValidationGate -- "Valid request input" --> ControllerHandler["Controller Handler<br/>(e.g., PortfolioController.getPortfolio)"]

  ControllerHandler --> ServiceLayer["Domain Service Layer<br/>(e.g., PortfolioService.getPortfolio)"]

  ServiceLayer --> TxCheck{"Atomic Write Required?<br/>(e.g., Admin Import)"}

  TxCheck -- "Yes" --> DbTransaction["db.transaction(async tx => ...)<br/>ACID Transaction Scope"]
  TxCheck -- "No (Read Query)" --> DrizzleQuery["Drizzle ORM Query Builder<br/>Parameterized SQL Execution"]

  DbTransaction --> DrizzleQuery
  DrizzleQuery --> PgEngine[("PostgreSQL 16 Engine<br/>Tables, Views, Indexes")]

  PgEngine -- "Query Result" --> ResultTransform["Domain Data Transformation<br/>(Totals, Unrealised PnL, Allocation)"]
  PgEngine -. "Database Error / Constraint Violation" .-> GlobalFilter["Global Exception Filter<br/>(Standardized Error Response)"]

  GlobalFilter --> RespError["HTTP Error Response<br/>(500, 404, 409 Conflict)"]
  ResultTransform --> HttpSuccess(["200 OK / 201 Created<br/>JSON Serialization"])
