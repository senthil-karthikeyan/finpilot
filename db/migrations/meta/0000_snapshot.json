          "notNull": false
        },
        "market_value": {
          "name": "market_value",
          "type": "numeric(18, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "cost_basis": {
          "name": "cost_basis",
          "type": "numeric(18, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "unrealised_pnl": {
          "name": "unrealised_pnl",
          "type": "numeric(18, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "unrealised_pnl_pct": {
          "name": "unrealised_pnl_pct",
          "type": "numeric(18, 2)",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  SELECT\n    h.account_id,\n    a.customer_id,\n    a.account_type,\n    a.provider,\n    a.status                                                          AS account_status,\n    a.base_currency,\n    h.instrument_id,\n    i.symbol,\n    i.instrument_name,\n    i.asset_class,\n    i.sector,\n    i.risk_band,\n    i.last_price,\n    i.price_as_of,\n    h.quantity,\n    h.avg_cost,\n    h.snapshot_date,\n    ROUND(h.quantity * i.last_price,                           2)    AS market_value,\n    ROUND(h.quantity * h.avg_cost,                             2)    AS cost_basis,\n    ROUND(h.quantity * i.last_price - h.quantity * h.avg_cost, 2)    AS unrealised_pnl,\n    CASE WHEN h.avg_cost > 0\n      THEN ROUND((i.last_price - h.avg_cost) / h.avg_cost * 100, 2)\n      ELSE NULL\n    END                                                               AS unrealised_pnl_pct\n  FROM holdings_snapshot h\n  JOIN accounts    a ON a.account_id    = h.account_id\n  JOIN instruments i ON i.instrument_id = h.instrument_id\n",
      "name": "v_portfolio_positions",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
