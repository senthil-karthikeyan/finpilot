  "views": {
    "public.v_monthly_net_flows": {
      "columns": {
        "customer_id": {
          "name": "customer_id",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "month": {
          "name": "month",
          "type": "date",
          "primaryKey": false,
          "notNull": false
        },
        "buy_total": {
          "name": "buy_total",
          "type": "numeric(18, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "sell_total": {
          "name": "sell_total",
          "type": "numeric(18, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "net_flow": {
          "name": "net_flow",
          "type": "numeric(18, 2)",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  SELECT\n    a.customer_id,\n    DATE_TRUNC('month', t.trade_date)::DATE                         AS month,\n    SUM(CASE WHEN t.transaction_type = 'BUY'  THEN t.amount ELSE 0 END)  AS buy_total,\n    SUM(CASE WHEN t.transaction_type = 'SELL' THEN t.amount ELSE 0 END)  AS sell_total,\n    SUM(CASE\n          WHEN t.transaction_type = 'SELL' THEN  t.amount\n          WHEN t.transaction_type = 'BUY'  THEN -t.amount\n          ELSE 0\n        END)                                                         AS net_flow\n  FROM transactions t\n  JOIN accounts a ON a.account_id = t.account_id\n  WHERE t.status          = 'SETTLED'\n    AND t.transaction_type IN ('BUY','SELL')\n    AND NOT t.is_future\n    AND t.trade_date >= DATE_TRUNC('month', CURRENT_DATE) - INTERVAL '11 months'\n  GROUP BY a.customer_id, DATE_TRUNC('month', t.trade_date)\n",
      "name": "v_monthly_net_flows",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
